# Địa chỉ backend. Điện thoại KHÔNG hiểu "localhost": dùng IP LAN của máy chạy backend
# (cùng Wi-Fi với điện thoại). Android emulator dùng http://10.0.2.2:3000/api
# Sau khi sửa file này phải khởi động lại: npx expo start --clear
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000/api

# dev: coi như đã đăng nhập, gửi header X-Dev-Role: customer (backend phải để AUTH_ENABLED khác true)
# keycloak: đăng nhập thật qua Keycloak (cần backend AUTH_ENABLED=true và các biến EXPO_PUBLIC_KEYCLOAK_* bên dưới)
EXPO_PUBLIC_AUTH_MODE=dev

# ---- Keycloak (chỉ dùng khi EXPO_PUBLIC_AUTH_MODE=keycloak) ----
# Địa chỉ Keycloak mà ĐIỆN THOẠI truy cập được: IP LAN của máy chạy Keycloak, KHÔNG phải localhost.
# IP này được ghi vào issuer của token nên backend phải liệt kê issuer tương ứng trong KEYCLOAK_ISSUERS
# (backend/.env), và redirect URI của Expo Go phải khai trong client hfarm-mobile. Đổi Wi-Fi mà IP đổi thì sửa lại các chỗ này.
EXPO_PUBLIC_KEYCLOAK_URL=http://192.168.1.10:8080
EXPO_PUBLIC_KEYCLOAK_REALM=hfarm
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=hfarm-mobile
