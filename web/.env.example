VITE_API_URL=http://localhost:3000/api

# Keycloak (realm hfarm, client công khai hfarm-web có bật PKCE S256)
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=hfarm
VITE_KEYCLOAK_CLIENT_ID=hfarm-web

# Tùy chọn: chạy CMS KHÔNG cần Keycloak (chỉ dùng khi backend để AUTH_ENABLED=false).
# Bỏ comment để bật; VITE_DEV_ROLE là admin (mặc định) hoặc staff, được gửi qua header X-Dev-Role.
# VITE_AUTH_DISABLED=true
# VITE_DEV_ROLE=admin
