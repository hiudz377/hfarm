DB_NAME=clothing_store

# AUTH_ENABLED=false: bỏ qua đăng nhập (giai đoạn đầu), mặc định coi như DEV_ROLE
# Ở chế độ này request có thể gửi header X-Dev-Role: admin|staff|customer để chọn vai trò
# (mobile gửi customer, web CMS không gửi nên dùng DEV_ROLE). Khi AUTH_ENABLED=true header bị bỏ qua.
# Khi gắn Keycloak: đổi thành true
AUTH_ENABLED=false
DEV_ROLE=admin
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=htbanqa
