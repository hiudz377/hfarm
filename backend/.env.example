PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=doi_mat_khau_cua_ban
DB_NAME=clothing_store

# ---------------------------------------------------------------------------
# Xác thực
# ---------------------------------------------------------------------------
# AUTH_ENABLED=false (mặc định): chế độ dev, KHÔNG cần Keycloak.
#   Mọi request coi như vai trò DEV_ROLE (admin|staff|customer); request có thể gửi header
#   X-Dev-Role: admin|staff|customer để chọn vai trò riêng (mobile gửi customer).
#
# AUTH_ENABLED=true: bắt buộc token Keycloak (header "Authorization: Bearer <token>").
#   Token được kiểm tra chữ ký (JWKS), issuer và hạn dùng; vai trò lấy từ claim realm_access.roles.
#   DEV_ROLE và header X-Dev-Role bị BỎ QUA hoàn toàn. Thiếu KEYCLOAK_URL/KEYCLOAK_REALM thì backend
#   không khởi động.
# Cách bật: đổi dòng dưới thành AUTH_ENABLED=true rồi khởi động lại backend.
AUTH_ENABLED=false
DEV_ROLE=admin

# Keycloak (chỉ dùng khi AUTH_ENABLED=true). KEYCLOAK_URL không có dấu "/" ở cuối.
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=hfarm

# Issuer được chấp nhận, cách nhau dấu phẩy. Keycloak ghi issuer theo địa chỉ client dùng để lấy token, nên khi
# web CMS (localhost) và điện thoại (IP LAN) cùng dùng một realm thì phải liệt kê CẢ HAI, ví dụ:
#   KEYCLOAK_ISSUERS=http://localhost:8080/realms/hfarm,http://192.168.1.18:8080/realms/hfarm
# Để trống = chỉ nhận issuer mặc định (KEYCLOAK_URL + /realms/ + KEYCLOAK_REALM). Đổi Wi-Fi mà IP máy đổi thì sửa dòng này.
# Chữ ký token luôn được kiểm tra bằng JWKS lấy qua KEYCLOAK_URL (backend phải truy cập được địa chỉ này).
KEYCLOAK_ISSUERS=

# Đăng ký tài khoản khách NGAY TRONG APP (không nhảy sang trang Keycloak). Chạy `npm run setup:keycloak -- --write-env` để tạo client
# hfarm-backend và tự ghi 2 dòng dưới (hoặc điền tay: client bảo mật có tài khoản dịch vụ, quyền manage-users, view-users, query-users, view-realm).
# Bỏ trống: app dùng trang đăng ký của Keycloak trong trình duyệt như trước.
KEYCLOAK_ADMIN_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_SECRET=
# Giới hạn đăng ký theo IP (mặc định 10 lần / 15 phút)
# REGISTER_RATE_LIMIT_MAX=10
# REGISTER_RATE_LIMIT_WINDOW_MS=900000

# Đơn vị vận chuyển mặc định khi nhân viên không nhập lúc chuyển đơn sang "Đang giao" (mã vận đơn luôn tự sinh nếu để trống).
# DEFAULT_CARRIER=HFarm Express

# Địa chỉ công khai của backend, dùng làm URL ảnh tải lên (/uploads/...). Mặc định http://localhost:3000.
# Chỉ cần đặt khi ảnh upload không hiện trên điện thoại (hoặc khi backend chạy ở địa chỉ công khai), ví dụ http://<IP_MAY_TINH>:3000
# Không có dấu "/" ở cuối. URL được lưu vào database lúc tải ảnh: đổi PUBLIC_URL sau đó thì ảnh đã tải lên vẫn mang địa chỉ cũ.
# PUBLIC_URL=http://localhost:3000

# CORS: các origin được gọi API, cách nhau dấu phẩy.
# Bỏ trống: AUTH_ENABLED=true -> chỉ http://localhost:5173 (web CMS); AUTH_ENABLED=false -> cho mọi origin.
CORS_ORIGIN=

# ---------------------------------------------------------------------------
# Thanh toán chuyển khoản (VietQR) + webhook ngân hàng
# ---------------------------------------------------------------------------
# Điền đủ BANK_BIN, BANK_ACCOUNT_NO, BANK_ACCOUNT_NAME thì bật chuyển khoản (server tự sinh mã VietQR đúng số tiền + nội dung).
# Để trống: app chỉ còn "Thanh toán khi nhận hàng" và backend từ chối đơn chuyển khoản. Giá trị dưới đây là MẪU GIẢ: thay bằng tài khoản thật.
# BANK_BIN: mã 6 số của ngân hàng theo NAPAS (Vietcombank 970436, MB 970422, Techcombank 970407, ACB 970416, BIDV 970418...).
# BANK_BIN=970436
# BANK_NAME=Vietcombank
# BANK_ACCOUNT_NO=0123456789
# BANK_ACCOUNT_NAME=TEN CHU TAI KHOAN KHONG DAU
# Khóa bí mật của webhook ngân hàng (SePay gửi kèm header "Authorization: Apikey <khóa>" tới POST /api/payments/webhook/sepay).
# Để trống: tắt hẳn webhook, nhân viên bấm "Xác nhận đã nhận tiền" trong CMS. Dùng chuỗi dài, ngẫu nhiên, không dùng lại ở nơi khác.
# PAYMENT_WEBHOOK_KEY=chuoi-bi-mat-dai-ngau-nhien
# Số phút giữ đơn chuyển khoản chưa trả; quá hạn backend tự hủy đơn (còn Chờ xác nhận) và hoàn kho + lượt mã giảm giá. Mặc định 1440 (24 giờ), tối thiểu 5.
# PAYMENT_HOLD_MINUTES=1440
# Đặt false để tắt tác vụ tự hủy đơn quá hạn (chạy mỗi phút).
# PAYMENT_EXPIRE_JOB=true

# ---------------------------------------------------------------------------
# Thông tin cửa hàng hiển thị trong app (màn Liên hệ, nút "Liên hệ cửa hàng" ở đơn hàng, chính sách đổi trả)
# ---------------------------------------------------------------------------
# Để trống trường nào thì app ẩn nút/dòng đó. Các giá trị dưới đây chỉ là mẫu GIẢ: điền thông tin thật vào .env (không đưa lên GitHub).
# STORE_NAME=HFarm
# STORE_PHONE=0900000000
# STORE_ZALO=0900000000
# STORE_EMAIL=cskh@example.com
# STORE_ADDRESS=Số 1, đường A, quận B, thành phố C
# STORE_HOURS=8:00 - 21:00 hằng ngày
# Số ngày khách được yêu cầu đổi trả kể từ khi nhận hàng (1 - 90, mặc định 7). Hiện trong Chính sách đổi trả của app.
# RETURN_DAYS=7
