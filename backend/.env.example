PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=doi_mat_khau_cua_ban
DB_NAME=clothing_store

# ---------------------------------------------------------------------------
# Xác thực
# ---------------------------------------------------------------------------
# AUTH_ENABLED=false (mặc định): chế độ dev, KHÔNG cần Keycloak.
#   Mọi request coi như vai trò DEV_ROLE (admin|staff|customer); request có thể gửi header
#   X-Dev-Role: admin|staff|customer để chọn vai trò riêng (mobile gửi customer).
#
# AUTH_ENABLED=true: bắt buộc token Keycloak (header "Authorization: Bearer <token>").
#   Token được kiểm tra chữ ký (JWKS), issuer và hạn dùng; vai trò lấy từ claim realm_access.roles.
#   DEV_ROLE và header X-Dev-Role bị BỎ QUA hoàn toàn. Thiếu KEYCLOAK_URL/KEYCLOAK_REALM thì backend
#   không khởi động.
# Cách bật: đổi dòng dưới thành AUTH_ENABLED=true rồi khởi động lại backend.
AUTH_ENABLED=false
DEV_ROLE=admin

# Keycloak (chỉ dùng khi AUTH_ENABLED=true). KEYCLOAK_URL không có dấu "/" ở cuối.
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=hfarm

# CORS: các origin được gọi API, cách nhau dấu phẩy.
# Bỏ trống: AUTH_ENABLED=true -> chỉ http://localhost:5173 (web CMS); AUTH_ENABLED=false -> cho mọi origin.
CORS_ORIGIN=
