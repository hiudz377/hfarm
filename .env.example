# Cấu hình cho `docker compose` (không bắt buộc: bỏ trống thì dùng giá trị mặc định ghi sau dấu :-).
# Sao chép thành .env (tệp .env không đưa vào Git) rồi sửa. Đổi biến VITE_* hoặc PUBLIC_URL thì phải build lại web:
#   docker compose up -d --build

# ---- Cổng trên máy bạn ----
# Mặc định tránh đụng khi bạn vẫn chạy bản dev (MySQL 3306, backend 3000, web 5173, Keycloak 8080).
API_PORT=3100
WEB_PORT=8088
DB_HOST_PORT=3307

# ---- MySQL trong Docker ----
# Chỉ có tác dụng ở LẦN ĐẦU tạo volume. Muốn đổi mật khẩu sau đó: docker compose down -v (XÓA dữ liệu) rồi up lại.
DB_PASSWORD=hfarm_docker_pw

# ---- Địa chỉ công khai của API ----
# Trình duyệt và điện thoại phải truy cập được địa chỉ này (dùng làm URL ảnh và địa chỉ API trong bản build của CMS).
# Điện thoại cùng Wi-Fi thì dùng IP của máy, ví dụ http://192.168.1.10:3100
PUBLIC_URL=http://localhost:3100

# ---- Đăng nhập ----
# Mặc định: chế độ dev, không cần Keycloak (CHỈ để chạy thử trên máy mình, ai gọi được API cũng có quyền admin).
AUTH_ENABLED=false
DEV_ROLE=admin
VITE_AUTH_DISABLED=true
VITE_DEV_ROLE=admin
# Dùng Keycloak của bạn: đặt AUTH_ENABLED=true, VITE_AUTH_DISABLED=false và điền các dòng dưới (xem README mục Keycloak).
# Backend chạy trong container nên KEYCLOAK_URL phải là địa chỉ container với tới được (ví dụ http://host.docker.internal:8080).
KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_ISSUERS=
# Đăng ký tài khoản ngay trong app (chạy `npm run setup:keycloak` ở thư mục backend để lấy 2 giá trị này)
KEYCLOAK_ADMIN_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_SECRET=
CORS_ORIGIN=
VITE_KEYCLOAK_URL=
VITE_KEYCLOAK_REALM=
VITE_KEYCLOAK_CLIENT_ID=

# Đơn vị vận chuyển mặc định khi nhân viên không nhập lúc giao hàng
DEFAULT_CARRIER=HFarm Express

# ---- Thanh toán chuyển khoản (VietQR) ----
# Để trống: tắt chuyển khoản, app chỉ còn "Thanh toán khi nhận hàng". Điền đủ 3 dòng BANK_BIN, BANK_ACCOUNT_NO, BANK_ACCOUNT_NAME để bật.
# Giá trị dưới đây chỉ là MẪU GIẢ: thay bằng tài khoản thật của cửa hàng trong file .env (KHÔNG đưa .env lên Git).
# BANK_BIN: mã 6 số của ngân hàng theo NAPAS (ví dụ Vietcombank 970436, MB 970422, Techcombank 970407, ACB 970416).
# BANK_BIN=970436
# BANK_NAME=Vietcombank
# BANK_ACCOUNT_NO=0123456789
# BANK_ACCOUNT_NAME=TEN CHU TAI KHOAN KHONG DAU
# Khóa bí mật của webhook ngân hàng (SePay gửi kèm header Authorization: Apikey <khóa>). Để trống: tắt webhook, nhân viên xác nhận tay trong CMS.
# PAYMENT_WEBHOOK_KEY=chuoi-bi-mat-dai-ngau-nhien
# Số phút giữ đơn chuyển khoản chưa trả trước khi tự hủy và hoàn kho (mặc định 1440 = 24 giờ, tối thiểu 5)
# PAYMENT_HOLD_MINUTES=1440

# ---------------------------------------------------------------------------
# Thông tin cửa hàng hiển thị trong app (màn Liên hệ, nút "Liên hệ cửa hàng" ở đơn hàng, chính sách đổi trả)
# ---------------------------------------------------------------------------
# Để trống trường nào thì app ẩn nút/dòng đó. Các giá trị dưới đây chỉ là mẫu GIẢ: điền thông tin thật vào .env (không đưa lên GitHub).
# STORE_NAME=HFarm
# STORE_PHONE=0900000000
# STORE_ZALO=0900000000
# STORE_EMAIL=cskh@example.com
# STORE_ADDRESS=Số 1, đường A, quận B, thành phố C
# STORE_HOURS=8:00 - 21:00 hằng ngày
# Số ngày khách được yêu cầu đổi trả kể từ khi nhận hàng (1 - 90, mặc định 7). Hiện trong Chính sách đổi trả của app.
# RETURN_DAYS=7
