# Địa chỉ backend. Điện thoại KHÔNG hiểu "localhost": dùng IP LAN của máy chạy backend
# (cùng Wi-Fi với điện thoại). Android emulator dùng http://10.0.2.2:3000/api
# Sau khi sửa file này phải khởi động lại: npx expo start --clear
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000/api

# dev: coi như đã đăng nhập, gửi header X-Dev-Role: customer (backend phải để AUTH_ENABLED khác true)
# Sau này đổi sang keycloak khi gắn đăng nhập thật
EXPO_PUBLIC_AUTH_MODE=dev
